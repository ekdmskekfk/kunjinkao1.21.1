# 管理员配置示例
#
# 实际文件由模组首次启动时自动生成，位置：
#   客户端整合实例：<实例目录>/config/kunjinkao-admin.toml
#   专用服务端：    <服务端目录>/config/kunjinkao-admin.toml
#
# 该文件只存在于本地，不会随模组 jar 分发给玩家。修改后需要重启游戏/服务器生效。
#
# 授权流程：
#   1. 玩家在游戏内按 ] 键打开「管理员密码验证」界面，输入下面配置的密码；
#   2. 服务端校验通过后，把该玩家的 UUID 记入当前存档（kunjinkao_password_admins）；
#   3. 该玩家随后即可使用战术 HUD（H 键）与管理员剑相关功能。
#
# 注意：
#   * 授权是按存档记录的，换存档需要重新验证。
#   * 管理员剑的合成同样受此权限限制，未授权者合成会返还材料。
#   * 持有管理员剑的防护/覆写效果不看权限，只看是否持剑。

["admin"]
	# 管理员密码。玩家在游戏内通过该密码验证后即可使用战术 HUD 与管理员剑。
	# 默认值是公开的，请务必改成你自己的密码。
	# 留空表示关闭密码验证，任何人都无法通过密码取得管理员权限。
	password = "118329"
